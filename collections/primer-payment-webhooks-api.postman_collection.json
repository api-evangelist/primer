de\": \"<string>\",\n          \"paymentMethodAdviceMessage\": \"<string>\",\n          \"advisedAction\": \"STOP_ALL_PAYMENTS\"\n        },\n        \"reason\": \"<string>\"\n      },\n      {\n        \"processorMerchantId\": \"<string>\",\n        \"date\": \"<string>\",\n        \"amount\": \"<long>\",\n        \"currencyCode\": \"MDL\",\n        \"orderId\": \"<string>\",\n        \"transactionType\": \"SALE\",\n        \"processorTransactionId\": \"<string>\",\n        \"processorName\": \"<string>\",\n        \"processorStatus\": \"DECLINED\",\n        \"processorStatusReason\": {\n          \"type\": \"ISSUER_DECLINED\",\n          \"declineType\": \"HARD_DECLINE\",\n          \"code\": \"LOST_OR_STOLEN_CARD\",\n          \"message\": \"<string>\",\n          \"paymentMethodResultCode\": \"<string>\",\n          \"paymentMethodResultMessage\": \"<string>\",\n          \"paymentMethodAdviceCode\": \"<string>\",\n          \"paymentMethodAdviceMessage\": \"<string>\",\n          \"advisedAction\": \"DO_NOT_RETRY\"\n        },\n        \"reason\": \"<string>\"\n      }\n    ],\n    \"riskData\": {\n      \"fraudChecks\": {\n        \"source\": \"<string>\",\n        \"preAuthorizationResult\": \"REFUSE\",\n        \"preAuthorizationRecommendation\": \"TRANSACTION_RISK_ANALYSIS\",\n        \"postAuthorizationResult\": \"THREE_DS\"\n      },\n      \"cvvCheck\": {\n        \"source\": \"<string>\",\n        \"result\": \"NOT_APPLICABLE\"\n      },\n      \"avsCheck\": {\n        \"source\": \"<string>\",\n        \"result\": {\n          \"streetAddress\": \"NOT_MATCHED\",\n          \"postalCode\": \"NOT_APPLICABLE\"\n        }\n      }\n    }\n  }\n}",
