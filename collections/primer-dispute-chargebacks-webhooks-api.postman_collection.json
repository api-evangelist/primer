      "item": [
        {
          "name": "Dispute Status",
          "id": "17edaa1b-5553-430d-85c0-a97320637e21",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "(Required) An [HMAC signature](https://en.wikipedia.org/wiki/HMAC) generated using the webhook payload and a shared signing secret. This is then converted to a base64 encoded string.",
                "key": "X-Signature-Primary",
                "value": "<string>"
              },
              {
                "description": "(Required) A secondary signature that is added when you have rotated your secret within the past 24 hours.",
                "key": "X-Signature-Secondary",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"<string>\",\n  \"version\": \"<string>\",\n  \"type\": \"DISPUTE\",\n  \"status\": \"ACCEPTED\",\n  \"primerAccountId\": \"<string>\",\n  \"transactionId\": \"<string>\",\n  \"orderId\": \"<string>\",\n  \"paymentId\": \"<string>\",\n  \"paymentMethod\": {\n    \"paymentMethodType\": \"<string>\",\n    \"paymentMethodData\": {\n      \"network\": \"PRIVATE_LABEL\"\n    }\n  },\n  \"processor\": \"ADYEN\",\n  \"processorDisputeId\": \"<string>\",\n  \"receivedAt\": \"<dateTime>\",\n  \"challengeRequiredBy\": \"<dateTime>\",\n  \"reason\": \"<string>\",\n  \"reasonCode\": \"<string>\",\n  \"processorReason\": \"<string>\",\n  \"amount\": \"<long>\",\n  \"currency\": \"<string>\",\n  \"merchantId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/dispute-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dispute-status"
              ]
            },
            "description": "Primer notifies you with a `DISPUTE.STATUS` webhook that will provide information on retrievals, disputes (also known as chargebacks), and preabritration filings.\n\nThis notification is supported for processors Adyen, Braintree, Checkout.com & PayPal.\n\nThe `DISPUTE.STATUS` event can be used to proactively communicate with customers, issue refunds, send disputes to risk tools, or to proactively defend disputes.\n\nThe `DISPUTE.STATUS` event is currently in an open beta stage, as we continue to add more processors.\n\nLearn more about managing disputes at Primer."
          },
